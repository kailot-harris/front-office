# subagent-brief run logs (may contain sensitive output)
/.subagent-runs/

# config.R-managed cache (regenerated via cache_path(), not source-controlled)
/cache/

# Claude subagent worktrees and local configs
/.claude/

# Pipeline log files and DuckDB store
/logs/

# Secrets and environment files
.env
.env.*
.Renviron

# Next.js web application dependencies & build output
/web/node_modules/
/web/.next/
/web/out/
/web/test-results/
/web/tsconfig.tsbuildinfo

# Root-level test output (tools/offseason/test_dag_end_to_end.R writes
# test-results/SUMMARY.md here; left behind on a failed run it forced the
# scheduled checkout guard into 'git stash push -u')
/test-results/

# Agent-written planning/handoff docs (kept locally, not published)
docs/internal/
